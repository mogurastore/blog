---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getAllArticles } from '../../lib/articles';

const posts = await getAllArticles();

const postsByYear: Record<number, typeof posts> = {};
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	if (!postsByYear[year]) postsByYear[year] = [];
	postsByYear[year].push(post);
}

const years = Object.keys(postsByYear).map(Number).sort().reverse();
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Archive | ${SITE_TITLE}`} description="記事一覧" />
		<style>
			h1 {
				margin-bottom: 1.5em;
			}
			.year-group {
				margin-bottom: 2.5em;
			}
			.year-group h2 {
				font-size: 1.5rem;
				margin: 0 0 0.75em 0;
				color: rgb(var(--gray));
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-list li {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.5em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-list li:last-child {
				border-bottom: none;
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.875rem;
				flex-shrink: 0;
			}
			.post-list a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.post-list a:hover {
				color: rgb(var(--accent));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Archive</h1>
			{
				years.map((year) => (
					<div class="year-group">
						<h2>{year}</h2>
						<ul class="post-list">
							{
								postsByYear[year].map((post) => (
									<li>
										<span class="date"><FormattedDate date={post.data.pubDate} /></span>
										<a href={`/articles/${post.id}/`}>{post.data.title}</a>
									</li>
								))
							}
						</ul>
					</div>
				))
			}
		</main>
		<Footer />
	</body>
</html>
